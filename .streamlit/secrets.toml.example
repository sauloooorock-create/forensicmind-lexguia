# Copia este archivo a .streamlit/secrets.toml (local) o pega su contenido en
# Settings > Secrets de Streamlit Cloud. NUNCA subas secrets.toml real al repo.

# Hash de la contraseña de admin: genéralo con `python -m forensicmind.security`
ADMIN_PASSWORD_HASH = "pbkdf2_sha256$...pega_aqui_el_hash..."
ADMIN_EMAIL = "contacto@forensicmind.mx"

# Respaldo privado en GitHub (repo PRIVADO aparte, token solo con Contents: read/write a ese repo)
GITHUB_REPO = "tu-usuario/tu-repo-privado"
GITHUB_TOKEN = "github_pat_..."
GITHUB_BRANCH = "main"

# Solo si de verdad quieres permitir respaldos en un repo público (no recomendado)
PERMITIR_REPO_PUBLICO = "no"

# Contacto y asistencia (opcionales)
WHATSAPP_DESPACHO = ""
ANTHROPIC_API_KEY = ""
ANTHROPIC_MODEL = "claude-sonnet-5-5"
